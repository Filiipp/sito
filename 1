<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Il mio catalogo</title>
<meta name="description" content="Sfoglia i prodotti per categoria e richiedi informazioni con un tocco.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F5F7F8; --card:#FFFFFF; --ink:#18222B; --muted:#5B6874;
  --line:#DCE3E8; --accent:#0E6B6B; --accent-ink:#FFFFFF; --soft:#DDEDEC;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:"Bricolage Grotesque",system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.5}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}

header{padding:56px 0 28px}
header h1{font-size:clamp(2.2rem,6vw,3.8rem);font-weight:800;line-height:1.05;margin:0 0 12px;letter-spacing:-.02em}
header p{margin:0;max-width:52ch;color:var(--muted);font-size:1.1rem}

.tools{position:sticky;top:0;z-index:5;background:var(--bg);padding:14px 0;border-bottom:1px solid var(--line)}
.search{width:100%;padding:13px 16px;font:inherit;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink)}
.chips{display:flex;gap:8px;margin-top:12px;overflow-x:auto;padding-bottom:4px}
.chip{flex:none;font:inherit;font-weight:600;padding:8px 16px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}
.chip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}

.count{margin:22px 0 14px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px;padding-bottom:60px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column}
.photo{aspect-ratio:4/3;background:var(--soft);display:grid;place-items:center;font-size:3rem;font-weight:800;color:var(--accent)}
.photo img{width:100%;height:100%;object-fit:cover;display:block}
.body{padding:16px;display:flex;flex-direction:column;gap:6px;flex:1}
.cat{font-size:.85rem;color:var(--muted)}
.body h3{margin:0;font-size:1.2rem}
.body p{margin:0;color:var(--muted);font-size:.95rem;flex:1}
.price{font-weight:800;font-size:1.15rem;margin-top:6px}
.actions{display:flex;gap:8px;margin-top:10px}
.btn{flex:1;text-align:center;text-decoration:none;font-weight:600;padding:10px 12px;border-radius:9px;border:1px solid var(--accent)}
.btn.primary{background:var(--accent);color:var(--accent-ink)}
.btn.ghost{color:var(--accent)}
.btn:hover{filter:brightness(.92)}
.empty{grid-column:1/-1;padding:40px 0;color:var(--muted)}

footer{border-top:1px solid var(--line);padding:28px 0 40px;color:var(--muted);font-size:.95rem}
</style>
</head>
<body>

<header>
  <div class="wrap">
    <h1>Il mio catalogo</h1>
    <p>Scegli una categoria o cerca un prodotto. Quando ne trovi uno che ti interessa, toccando il pulsante mi arriva subito un messaggio.</p>
  </div>
</header>

<div class="tools">
  <div class="wrap">
    <input class="search" id="q" type="search" placeholder="Cerca un prodotto" aria-label="Cerca un prodotto">
    <div class="chips" id="chips" role="group" aria-label="Categorie"></div>
  </div>
</div>

<main class="wrap">
  <p class="count" id="count" aria-live="polite"></p>
  <div class="grid" id="grid"></div>
</main>

<footer>
  <div class="wrap" id="foot"></div>
</footer>

<script>
/* =====================================================
   1) MODIFICA QUI I TUOI DATI DI CONTATTO
   ===================================================== */
const CONTATTI = {
  nome: "Il mio negozio",
  whatsapp: "393331234567",      // prefisso + numero, senza + né spazi (39 = Italia)
  email: "info@iltuodominio.it"
};

/* =====================================================
   2) MODIFICA QUI I TUOI PRODOTTI
   - categoria: usa sempre lo stesso nome per i prodotti dello stesso gruppo
   - foto: nome del file caricato nella cartella "foto" (es. "foto/lampada.jpg").
           Lascia "" per mostrare un segnaposto.
   ===================================================== */
const PRODOTTI = [
  { nome: "Prodotto di esempio 1", categoria: "Categoria A", prezzo: "€ 25", foto: "", descrizione: "Breve descrizione del prodotto: materiali, misure, utilizzo." },
  { nome: "Prodotto di esempio 2", categoria: "Categoria A", prezzo: "€ 40", foto: "", descrizione: "Breve descrizione del prodotto: materiali, misure, utilizzo." },
  { nome: "Prodotto di esempio 3", categoria: "Categoria B", prezzo: "€ 15", foto: "", descrizione: "Breve descrizione del prodotto: materiali, misure, utilizzo." },
  { nome: "Prodotto di esempio 4", categoria: "Categoria B", prezzo: "€ 60", foto: "", descrizione: "Breve descrizione del prodotto: materiali, misure, utilizzo." },
  { nome: "Prodotto di esempio 5", categoria: "Categoria C", prezzo: "€ 90", foto: "", descrizione: "Breve descrizione del prodotto: materiali, misure, utilizzo." },
  { nome: "Prodotto di esempio 6", categoria: "Categoria C", prezzo: "Su richiesta", foto: "", descrizione: "Breve descrizione del prodotto: materiali, misure, utilizzo." }
];

/* =====================================================
   Da qui in giù non serve cambiare nulla
   ===================================================== */
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let categoria = "Tutti";

const categorie = ["Tutti", ...new Set(PRODOTTI.map(p => p.categoria))];

function disegnaChips(){
  $("chips").innerHTML = categorie.map(c =>
    `<button class="chip" aria-pressed="${c===categoria}" data-c="${esc(c)}">${esc(c)}</button>`).join("");
}

function linkWhatsApp(p){
  const t = `Salve, sono interessato a "${p.nome}" (${p.categoria}). Potete darmi maggiori informazioni?`;
  return `https://wa.me/${CONTATTI.whatsapp}?text=${encodeURIComponent(t)}`;
}
function linkEmail(p){
  const s = `Richiesta informazioni: ${p.nome}`;
  const b = `Salve,\n\nsono interessato al prodotto "${p.nome}" (${p.categoria}).\nPotete darmi maggiori informazioni?\n\nGrazie`;
  return `mailto:${CONTATTI.email}?subject=${encodeURIComponent(s)}&body=${encodeURIComponent(b)}`;
}

function disegna(){
  const q = $("q").value.trim().toLowerCase();
  const lista = PRODOTTI.filter(p =>
    (categoria === "Tutti" || p.categoria === categoria) &&
    (!q || (p.nome + " " + p.descrizione + " " + p.categoria).toLowerCase().includes(q)));
  $("count").textContent = lista.length === 1 ? "1 prodotto" : lista.length + " prodotti";
  $("grid").innerHTML = lista.length ? lista.map(p => `
    <article class="card">
      <div class="photo">${p.foto ? `<img src="${esc(p.foto)}" alt="${esc(p.nome)}" loading="lazy">` : esc(p.nome.charAt(0))}</div>
      <div class="body">
        <span class="cat">${esc(p.categoria)}</span>
        <h3>${esc(p.nome)}</h3>
        <p>${esc(p.descrizione)}</p>
        <div class="price">${esc(p.prezzo)}</div>
        <div class="actions">
          <a class="btn primary" href="${linkWhatsApp(p)}" target="_blank" rel="noopener">WhatsApp</a>
          <a class="btn ghost" href="${linkEmail(p)}">Email</a>
        </div>
      </div>
    </article>`).join("")
    : `<p class="empty">Nessun prodotto trovato. Prova con un'altra parola o categoria.</p>`;
}

$("chips").addEventListener("click", e => {
  const b = e.target.closest(".chip"); if(!b) return;
  categoria = b.dataset.c; disegnaChips(); disegna();
});
$("q").addEventListener("input", disegna);

$("foot").innerHTML = `<strong>${esc(CONTATTI.nome)}</strong><br>
  <a href="https://wa.me/${CONTATTI.whatsapp}" target="_blank" rel="noopener">WhatsApp</a> ·
  <a href="mailto:${esc(CONTATTI.email)}">${esc(CONTATTI.email)}</a>`;

disegnaChips(); disegna();
</script>
</body>
</html>
